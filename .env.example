# Copie para .env e preencha com os dados do SEU projeto Supabase.
# NUNCA versione o .env real.

# --- Cliente (expostas ao browser via Vite, embutidas em BUILD-TIME) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon). O código aceita os DOIS nomes — use um deles:
VITE_SUPABASE_PUBLISHABLE_KEY=sua-anon-publishable-key
# VITE_SUPABASE_ANON_KEY=sua-anon-publishable-key   # alias equivalente
VITE_SUPABASE_PROJECT_ID=seu-project-id

# --- Servidor (SSR / server functions, lidas em RUNTIME) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-anon-publishable-key
# SUPABASE_ANON_KEY=sua-anon-publishable-key        # alias equivalente
SUPABASE_PROJECT_ID=seu-project-id

# Apenas para operações administrativas no servidor (client.server.ts).
# NÃO exponha com prefixo VITE_. Opcional se você não usar supabaseAdmin.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Diagnóstico: defina como 1 para a página de erro do SSR mostrar o stack real
# no navegador (em vez de "This page didn't load"). Desligue depois.
# DEBUG_SSR_ERRORS=1
